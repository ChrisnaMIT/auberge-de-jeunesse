{% extends 'pms/pms_base.html.twig' %}

{% block title %}{{ room.name }}{% endblock %}

{% block body %}
    <section class="min-vh-100 d-flex align-items-center justify-content-center" style="background: #f3f4f6;">
        <div class="card shadow-lg border-0 rounded-4 p-5" style="max-width: 700px; width: 100%;">
            <h2 class="fw-bold text-dark mb-4 text-center">{{ room.name }}</h2>

            <p><strong>Type :</strong> {{ room.type }}</p>
            <p><strong>Prix par nuit :</strong> {{ room.pricePerNight }} €</p>
            <p><strong>Nombre de lits :</strong> {{ room.numberOfBeds }}</p>
            <p><strong>Dortoir mixte :</strong> {{ room.isMixed ? 'Oui' : 'Non' }}</p>
            <p><strong>Description :</strong><br>{{ room.description }}</p>
            <p><strong>Statut :</strong>
                <span class="badge bg-{{ room.status == 'available' ? 'success' : (room.status == 'occupied' ? 'danger' : 'warning') }}">
                {{ room.status|capitalize }}
            </span>
            </p>

            {% if room.amenities is not empty %}
                <div class="mt-3">
                    <strong>Commodités :</strong>
                    <ul class="mt-2">
                        {% for amenity in room.amenities %}
                            <li>{{ amenity.name }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <h3 class="mt-4">Lits dans cette chambre</h3>

            <div class="row">
                {% for bed in room.beds %}
                    <div class="col-3">
                        <div class="p-3 bg-white rounded shadow-sm mb-3">

                            <strong>Lit {{ bed.number }}</strong><br>

                            {% if bed.status == 'available' %}
                                <span class="badge bg-success">Disponible</span>
                            {% elseif bed.status == 'occupied' %}
                                <span class="badge bg-danger">Occupé</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">Maintenance</span>
                            {% endif %}

                            <div class="mt-3">
                                <a href="{{ path('app_bed_show', {id: bed.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                                <a href="{{ path('app_bed_edit', {id: bed.id}) }}" class="btn btn-sm btn-secondary">Modifier</a>
                                <a href="{{ path('app_bed_delete', {id: bed.id}) }}" class="btn btn-sm btn-danger">Supprimer</a>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>


            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="{{ path('app_room') }}" class="btn btn-outline-secondary px-4">← Retour</a>
                <a href="{{ path('app_bed_create', { room: room.id }) }}" class="btn btn-primary"> + Ajouter un lit</a>


                <div>
                    <a href="{{ path('app_room_edit', {'id': room.id}) }}" class="btn btn-primary px-4 me-2">Modifier</a>
                    <a href="{{ path('app_room_delete', {'id': room.id}) }}" class="btn btn-danger px-4"
                       onclick="return confirm('Supprimer cette chambre ?')">Supprimer</a>
                </div>
            </div>
        </div>
    </section>

    <style>
        body { background-color: #f3f4f6; font-family: "Inter", sans-serif; }
        .card { background: #fff; border-radius: 1rem; }
    </style>
{% endblock %}
