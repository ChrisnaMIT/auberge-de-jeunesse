{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="card shadow p-4" style="width: 380px;">

            <h2 class="fw-bold text-center mb-3">Connexion</h2>
            <p class="text-center text-muted mb-4">Accédez à votre espace</p>

            {% if error %}
                <div class="alert alert-danger">
                    Identifiants incorrects.
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">Email</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username"
                           class="form-control" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" required>
                </div>

                <button class="btn btn-primary w-100 mt-3">Se connecter</button>
            </form>

            <div class="text-center mt-3">
                <a href="{{ path('app_register') }}" class="text-decoration-none">Créer un compte</a>
            </div>

        </div>
    </div>
{% endblock %}
