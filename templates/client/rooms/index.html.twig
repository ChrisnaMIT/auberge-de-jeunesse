{% extends 'base.html.twig' %}

{% block title %}Choisir votre dortoir{% endblock %}

{% block body %}

    <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-16">

        <div class="max-w-7xl mx-auto px-6">

            <h1 class="text-5xl font-extrabold text-center mb-4 tracking-tight text-gray-800">
                Réservez votre lit facilement
            </h1>

            <p class="text-center text-gray-600 text-lg mb-14">
                Découvrez nos dortoirs et choisissez vos dates parmi les disponibilités.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10">

                {% for room in rooms %}

                    <div class="bg-white rounded-3xl shadow-xl hover:shadow-2xl transition-all border border-gray-200 overflow-hidden">

                        <div class="h-44 bg-cover bg-center"
                             style="background-image: url('https://source.unsplash.com/800x600/?hostel,dorm,bed');">
                        </div>

                        <div class="p-6">

                            <div class="flex justify-between items-center mb-3">
                                <h2 class="text-2xl font-bold text-gray-800">
                                    {{ room.name }}
                                </h2>

                                <span class="px-3 py-1 text-xs font-semibold rounded-full
                                {% if room.type == 'dorm' %}
                                    bg-blue-100 text-blue-700
                                {% else %}
                                    bg-green-100 text-green-700
                                {% endif %}">
                                {{ room.type == 'dorm' ? 'Dortoir' : 'Privée' }}
                            </span>
                            </div>

                            <div class="space-y-2 text-gray-700">

                                <p class="flex items-center gap-2 text-lg">
                                    💰 <strong>{{ room.pricePerNight }} €</strong> / nuit
                                </p>

                                <p class="flex items-center gap-2 text-lg">
                                    🛏️ {{ room.beds|length }} lits dans ce dortoir
                                </p>

                            </div>

                            <a href="{{ path('client_room_availability', { id: room.id }) }}"
                               class="mt-6 block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition-all text-lg shadow-md hover:shadow-lg">
                                Voir les disponibilités
                            </a>

                        </div>

                    </div>

                {% endfor %}

            </div>

        </div>

    </div>

{% endblock %}

