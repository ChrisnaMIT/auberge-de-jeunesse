{% extends 'pms/pms_base.html.twig' %}

{% block title %}Détails de la réservation{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-2xl mt-10 bg-white shadow-md rounded-2xl p-8">
        <h1 class="text-2xl font-bold mb-6 text-center">Réservation de {{ booking.room.name }}</h1>

        <div class="space-y-2 text-gray-700">
            <p><strong>Chambre :</strong> {{ booking.room.name }}</p>


            <p><strong>Type :</strong> {{ booking.room.type }}</p>
            <p><strong>Dates :</strong> {{ booking.checkIn|date('d/m/Y') }} → {{ booking.checkOut|date('d/m/Y') }}</p>
            <p><strong>Nombre de lits :</strong> {{ booking.numberOfBedsReserved}}</p>
            <p><strong>Statut :</strong> {{ booking.status }}</p>
            <p><strong>Prix total :</strong> {{ booking.totalPrice }} €</p>

        </div>

        <div class="flex justify-between mt-6">
            <a href="{{ path('app_booking') }}" class="text-blue-600 hover:underline">← Retour</a>
            <div class="flex gap-3">
                <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="text-yellow-600 hover:underline">Modifier</a>
                <a href="{{ path('app_booking_delete', {'id': booking.id}) }}" class="text-red-600 hover:underline"
                   onclick="return confirm('Supprimer cette réservation ?')">Supprimer</a>
            </div>
        </div>
    </div>
{% endblock %}
