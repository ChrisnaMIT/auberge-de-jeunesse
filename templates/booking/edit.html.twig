{% extends 'pms/pms_base.html.twig' %}

{% block title %}Modifier la réservation{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-xl mt-10 bg-white shadow-md rounded-2xl p-8">
        <h1 class="text-2xl font-bold mb-6 text-center">Modifier la réservation</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
        {{ form_row(form.room, {'label': 'Chambre'}) }}
        {{ form_row(form.checkIn, {'label': 'Date d\'arrivée'}) }}
        {{ form_row(form.checkOut, {'label': 'Date de départ'}) }}
        {{ form_row(form.numberOfBedsReserved, {'label': 'Nombre de lits réservés'}) }}
        {{ form_row(form.status, {'label': 'Statut'}) }}

        <div class="flex justify-end">
            <button class="px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700">
                Mettre à jour
            </button>
        </div>
        {{ form_end(form) }}

        <div class="mt-4 text-center">
            <a href="{{ path('app_booking') }}" class="text-blue-600 hover:underline">← Retour à la liste</a>
        </div>
    </div>
{% endblock %}
